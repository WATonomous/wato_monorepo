<?xml version="1.0" encoding="UTF-8"?>
<!--
  Resolve ROS package schemas locally for libxml2 2.15+, which removed HTTP support.
  The adjacent XSD files are unmodified copies from ros-infrastructure/rep:
  https://github.com/ros-infrastructure/rep/tree/11ca24a41f31480dfb9562ba99f2a5b93d3ebda5/xsd
  When updating, copy both package_format3.xsd and its include package_common.xsd.
-->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">
  <system systemId="http://download.ros.org/schema/package_format3.xsd" uri="package_format3.xsd"/>
  <system systemId="https://download.ros.org/schema/package_format3.xsd" uri="package_format3.xsd"/>
  <uri name="http://download.ros.org/schema/package_format3.xsd" uri="package_format3.xsd"/>
  <uri name="https://download.ros.org/schema/package_format3.xsd" uri="package_format3.xsd"/>
</catalog>
