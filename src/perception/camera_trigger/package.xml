<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_trigger</name>
  <version>0.0.0</version>
  <description>Receives pulse reports from the STM32 camera trigger board over UDP and publishes each pulse with its exact time</description>
  <maintainer email="hello@watonomous.ca">WATonomous</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>builtin_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>camera_trigger_msgs</depend>

  <test_depend>wato_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
