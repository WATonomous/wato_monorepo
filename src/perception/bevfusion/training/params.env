# shellcheck shell=bash
# Where the training scripts find data, weights and outputs. Edit for your machine.
# Every value can be overridden by setting the variable first (e.g. docker run -e RUNS=...).
# Defaults are for WATcloud.

# Storage root mounted at the same path on the host and in the container.
STORAGE="${STORAGE:-/mnt/wato-drive2}"
# Shared folder holding cuda-bevfusion-model/, the image tar and runs/.
SHARED="${SHARED:-$STORAGE/bevfusion_training_image}"
# Read-only mini dataset source.
NUSC_MINI_SRC="${NUSC_MINI_SRC:-$STORAGE/nuscenes-1.0-mini}"
# Read-only full dataset source.
NUSC_FULL_SRC="${NUSC_FULL_SRC:-$STORAGE/wato-datasets/nuscenes/full-dataset}"
# Folder containing the map expansion zip.
NUSC_MAP_DIR="${NUSC_MAP_DIR:-$STORAGE/wato-datasets/nuscenes/map-expansion}"
# Writable root built by link_nuscenes.sh; use $SHARED/nuscenes-full for full-dataset runs.
NUSC_DIR="${NUSC_DIR:-$SHARED/nuscenes-mini}"
# Training, evaluation and export outputs.
RUNS="${RUNS:-$SHARED/runs}"
# Retries for a failed sample read on network storage; 0 disables retries.
LOAD_RETRIES="${LOAD_RETRIES:-5}"
